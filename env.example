# Configurações do MiniKit / Privy
NEXT_PUBLIC_APP_ID=your_world_app_id_here
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id_here

# OnchainKit (Coinbase) API (removido: não utilizado para geração de wallet)

# Configurações da rede Base
NEXT_PUBLIC_BASE_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_BASE_TESTNET_RPC_URL=https://sepolia.base.org

# Contratos de Stablecoins na Base (endereços de exemplo)
NEXT_PUBLIC_USDC_CONTRACT=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
NEXT_PUBLIC_EURC_CONTRACT=0x60a3E35Cc302bFA44Cb288Bc5a4F316Fdb1adb42
NEXT_PUBLIC_BRZ_CONTRACT=0x420000000000000000000000000000000000000A

# Ngrok para desenvolvimento local
NGROK_DOMAIN=your-domain.ngrok-free.app

# API Keys (adicione conforme necessário)
NEXT_PUBLIC_COINGECKO_API_KEY=your_coingecko_api_key
NEXT_PUBLIC_MORALIS_API_KEY=your_moralis_api_key
NEXT_PUBLIC_COINBASE_API_KEY=

# Configurações de ambiente
NEXT_PUBLIC_ENVIRONMENT=development 

# Backend API (frontend)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Endereço do contrato CapyCoin na Base (preencha após deploy)
NEXT_PUBLIC_CAPYCOIN_ADDRESS=0xd3df432E90C30C5de2Dd7f44947BB26432FF07d6