# Server Configuration
PORT=3001
NODE_ENV=development
API_VERSION=v1

# StarkBank Configuration
STARKBANK_PROJECT_ID=your_starkbank_project_id_here
STARKBANK_PRIVATE_KEY_PATH=./keys/starkbank-private-key.pem
STARKBANK_ENVIRONMENT=sandbox
# sandbox ou production

# Webhook Configuration
WEBHOOK_BASE_URL=https://your-backend-domain.com
WEBHOOK_SECRET=your_webhook_secret_key_here

# Database Configuration (Future implementation)
DATABASE_URL=postgresql://username:password@localhost:5432/capypay
REDIS_URL=redis://localhost:6379

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=https://your-domain.com/auth/google/callback

# Wallet Encryption Configuration
WALLET_ENCRYPTION_KEY=your_32_byte_wallet_encryption_key_here
WALLET_SALT=your_wallet_salt_here
KMS_KEY_ID=your_kms_key_id_here
# Para produção, usar AWS KMS, Google Cloud KMS, ou Azure Key Vault

# Session Configuration
SESSION_SECRET=your_session_secret_key_here
SESSION_TIMEOUT=86400000
# 24 horas em millisegundos

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs/capy-pay.log

# External APIs
COINGECKO_API_KEY=your_coingecko_api_key
MORALIS_API_KEY=your_moralis_api_key

# Base Network Configuration (preferir Sepolia em dev/test)
BASE_RPC_URL=https://sepolia.base.org
BASE_TESTNET_RPC_URL=https://sepolia.base.org
BASE_PRIVATE_KEY=your_base_wallet_private_key
BASE_WALLET_ADDRESS=your_base_wallet_address

# Deposit Registry (onchain PIX)
DEPOSIT_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000

# Node Provider Configuration
ALCHEMY_API_KEY=your_alchemy_api_key_here
INFURA_API_KEY=your_infura_api_key_here
QUICKNODE_URL=your_quicknode_url_here

# 1inch API Configuration
ONEINCH_API_KEY=your_1inch_api_key_here
ONEINCH_BASE_URL=https://api.1inch.dev/swap/v6.0/8453

# Token Contracts (Base Network)
USDC_BASE_CONTRACT=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
BRZ_BASE_CONTRACT=
BRZ_DECIMALS=4
EURC_BASE_CONTRACT=0x60a3E35Cc302bFA44Cb288Bc5a4F316Fdb1adb42

# CapyCoin Configuration
CAPYCOIN_ADDRESS=0xd3df432E90C30C5de2Dd7f44947BB26432FF07d6
# Quantidade de CAPY por 1 BRL depositado via PIX
CAPY_PER_BRL=1
USDC_BRL_RATE_OVERRIDE=5.3

# Blockchain Monitoring
DEPOSIT_WALLET_ADDRESS=your_deposit_wallet_address
BLOCK_CONFIRMATION_COUNT=3
MONITORING_INTERVAL_MS=5000

# Security Configuration
ENCRYPTION_ALGORITHM=aes-256-gcm
HASH_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_TIME_MINUTES=30

# MiniKit Integration
MINIKIT_APP_ID=your_minikit_app_id
FARCASTER_API_KEY=your_farcaster_api_key

# Monitoring & Analytics
SENTRY_DSN=your_sentry_dsn_here
ANALYTICS_API_KEY=your_analytics_api_key 

# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret

# Swap Simulation
# Quando true, o SwapService usa cotações simuladas e retorna TXs falsas
SIMULATE_SWAPS=true

# Force Real Quotes
# Quando true, mesmo em simulação, a cotação é feita via 1inch
# Execução continua mockada quando SIMULATE_SWAPS=true
FORCE_REAL_QUOTES=false